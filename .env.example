# Данные инстанса MAX из личного кабинета GREEN-API: https://console.green-api.com
# Скопируйте файл в .env и заполните. При запуске через npm run dev форма входа
# подставит эти значения. В production-сборку они не попадают.

# Хост API, например https://3100.api.green-api.com
# Если пусто, адрес строится из первых четырёх цифр idInstance
apiUrl=

# Хост для отправки файлов. Приложение работает только с текстом и его не читает
mediaUrl=

# Номер инстанса
idInstance=

# Токен доступа к инстансу
apiTokenInstance=
